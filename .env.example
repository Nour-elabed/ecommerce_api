PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
SETUP_SECRET=replace-with-a-long-random-string-you-choose

# ── Database ──────────────────────────────────────────────────────────────────
# For LOCAL development (no Docker): point to your local MongoDB instance.
#   MONGO_URI=mongodb://localhost:27017/ecommerce
#
# For DOCKER: docker-compose overrides this to mongodb://mongo:27017/ecommerce
#   automatically — you do NOT need to change this file for Docker.
#
# For PRODUCTION (MongoDB Atlas): use the Atlas connection string.
#   MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/dbname?retryWrites=true&w=majority
#
# ⚠ Important: Each environment uses a SEPARATE database.
#   Data created locally won't appear in Docker and vice-versa.
MONGO_URI=mongodb://localhost:27017/ecommerce
